# Worker runtime bindings, server only. CI installs values per environment.
# Copy to ignored .dev.vars for local Wrangler development.
GOOGLE_CLIENT_ID= # OAuth web client ID (var or secret)
GOOGLE_CLIENT_SECRET= # OAuth web client secret
APPLE_SERVICES_ID= # Apple web Services ID (var or secret)
APPLE_TEAM_ID= # Apple developer team ID (var or secret)
APPLE_KEY_ID= # Apple signing key ID (var or secret)
APPLE_PRIVATE_KEY= # PEM key; secret, escaped newlines supported
AUTH_ENCRYPTION_KEY= # 32-byte base64url key; preserve when migrating identities

# CI discovery only; never install these in the Worker.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_STAGING_DATABASE_NAME=fearville-staging
D1_PRODUCTION_DATABASE_NAME=fearville-production

# Server-only; empty disables admin. Configure exactly one email.
ADMIN_EMAIL_ALLOWLIST=
ENVIRONMENT=local
APP_ORIGIN=https://fearville.app
