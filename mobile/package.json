{
  "name": "fearville-mobile-shell",
  "private": true,
  "description": "Capacitor shells for the hosted Fearville app.",
  "scripts": {
    "site": "node scripts/write-site.mjs",
    "sync": "node scripts/write-site.mjs && cap sync",
    "sync:ios": "node scripts/write-site.mjs && cap sync ios",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor-community/keep-awake": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
