{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fearville-local",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "env": {
    "staging": {
      "name": "fearville-staging",
      "vars": { "ENVIRONMENT": "staging", "APP_ORIGIN": "https://staging.fearville.app", "ADMIN_EMAIL_ALLOWLIST": "sybertechlabs@gmail.com", "SENTRY_ENVIRONMENT": "staging", "APNS_ENVIRONMENT": "sandbox" },
      "durable_objects": { "bindings": [{ "name": "ENVIRONMENT_PROBE", "class_name": "EnvironmentProbe" }] },
      "migrations": [{ "tag": "environment-probe-v1", "new_sqlite_classes": ["EnvironmentProbe"] }],
      "workers_dev": false,
      "routes": [{ "pattern": "staging.fearville.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fearville-staging",
          "database_id": "bc2ceaef-1022-4e01-abfa-44a022ed52aa",
          "migrations_dir": "drizzle",
        },
      ],
    },
    "production": {
      "name": "fearville-production",
      "vars": { "ENVIRONMENT": "production", "APP_ORIGIN": "https://fearville.app", "ADMIN_EMAIL_ALLOWLIST": "sybertechlabs@gmail.com", "SENTRY_ENVIRONMENT": "production", "APNS_ENVIRONMENT": "production" },
      "durable_objects": { "bindings": [{ "name": "ENVIRONMENT_PROBE", "class_name": "EnvironmentProbe" }] },
      "migrations": [{ "tag": "environment-probe-v1", "new_sqlite_classes": ["EnvironmentProbe"] }],
      "workers_dev": false,
      "routes": [{ "pattern": "fearville.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fearville-production",
          "database_id": "ee5bb171-1470-433f-8610-4ed13f1a5a56",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
}
