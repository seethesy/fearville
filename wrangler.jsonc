{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fearville-local",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "env": {
    "staging": {
      "name": "fearville-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.fearville.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fearville-staging",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "drizzle",
        },
      ],
    },
    "production": {
      "name": "fearville-production",
      "workers_dev": false,
      "routes": [{ "pattern": "fearville.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fearville-production",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
}
